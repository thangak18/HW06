      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;BỘ SINH TEST CASE API BẰNG AI — SƠ ĐỒ KIẾN TRÚC ĐƯỜNG ỐNG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;HW06 · MSSV 23127195 · SUT: EShop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;144 test case → 24 lỗi thật (4 Critical · 7 High · 8 Medium · 5 Low)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;" vertex="1" parent="1">
