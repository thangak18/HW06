        <mxCell id="o1" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Postman Collection v2.1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;chạy được bằng Newman&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;dashed=0;" vertex="1" parent="1">
