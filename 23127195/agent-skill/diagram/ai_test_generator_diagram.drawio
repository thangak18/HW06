        <mxCell id="o4" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Cổng chặn hồi quy cho CI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;baseline: 92 test case ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;550 assertion · 0 FAIL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;dashed=0;" vertex="1" parent="1">
