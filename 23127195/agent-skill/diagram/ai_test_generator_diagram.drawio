        <mxCell id="mt" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;SỐ LIỆU THẬT CỦA BÀI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;3 API kiểm thử: FR-04 (Pool A) · FR-09 (Pool B) · FR-16 (Pool C)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;110 TC (AI) + 34 TC (người) = 144 TC · 241 request · 746 assertion&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;24 lỗi thật: 4 Critical · 7 High · 8 Medium · 5 Low&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=0;" vertex="1" parent="1">
