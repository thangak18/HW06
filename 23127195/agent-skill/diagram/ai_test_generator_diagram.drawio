        <mxCell id="lgx5" value="&lt;font style=&quot;font-size:10px&quot;&gt;Đầu ra&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;" vertex="1" parent="1">
