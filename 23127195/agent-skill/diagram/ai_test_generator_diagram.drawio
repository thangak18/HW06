        <mxCell id="nm" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;&gt; Newman run&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;241 request · 746 assertion&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;92 PASS / 52 FAIL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=0;" vertex="1" parent="1">
