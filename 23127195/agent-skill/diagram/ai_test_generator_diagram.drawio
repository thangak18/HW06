        <mxCell id="lgl" value="&lt;font style=&quot;font-size:9px&quot;&gt;——— luồng chính     - - - đầu vào cấu hình / phản hồi&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="896" y="186" width="300" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="docA" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;api_specification.md&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Hợp đồng dữ liệu: endpoint, tham số,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ví dụ body, response 200&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;— không có SEC · không có FR&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="docB" value="&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;README.md  (bản SRS)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;FR-01…FR-24 (ràng buộc nghiệp vụ)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ SEC-01…SEC-07 (bảo mật)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;— không mô tả chi tiết hợp đồng API&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;! Vì sao phải là HAI nguồn&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Chỉ nạp api_specification.md → AI không&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;biết SEC-01…SEC-07 tồn tại.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;BUG-A1-01 · BUG-A2-03 · BUG-A3-02&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;vi phạm ràng buộc CHỈ có trong SRS.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="230" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;! Ràng buộc của G1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Mỗi ràng buộc kèm trích dẫn nguyên&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;   văn — không nguồn = ràng buộc bịa&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Chưa sinh test case ở bước này&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• KHÔNG xem response thật của SUT&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;G1 — TRÍCH XUẤT ĐẶC TẢ   [LLM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;GIAI ĐOẠN DUY NHẤT DÙNG LLM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Đọc hiểu tài liệu  →  EndpointModel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="340" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cat" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;DANH MỤC QUY TẮC PHÂN VÙNG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;do người viết · tất định&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Tính đầy đủ đến từ danh mục,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;không đến từ mô hình&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="em" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;EndpointModel  (JSON)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tham số · máy trạng thái ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;lược đồ response · SEC áp dụng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;G2 — PHÂN VÙNG MIỀN  [tất định]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;thiếu trường · null · sai kiểu&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;rỗng · CHỈ KHOẢNG TRẮNG · Unicode&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SQL injection · XSS · chuỗi-số&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;biên: min−1 · min · min+1 · max±1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ điểm v == min bắt BUG-A2-03&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;G3 — CHUYỂN TRẠNG THÁI  [tất định]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mọi cạnh hợp lệ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mọi cặp (từ, đến) bị cấm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cạnh tự lặp · rời trạng thái kết thúc&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cập nhật một phần&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ phải đọc lại tài nguyên để xác nhận&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;G4 — BẢO MẬT  [tất định]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SEC-02 token: rác · sai khoá · alg=none&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SEC-03 role · SEC-05 SQLi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SEC-06 trường ngoài đặc tả (role, id…)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SEC-01 rò rỉ · IDOR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ chứng minh hậu quả quan sát được&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;G5 — LƯỢC ĐỒ RESPONSE  [tất định]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Thuận: đủ trường · đúng kiểu ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Content-Type · response lỗi khớp&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;NGHỊCH: không có trường ngoài hợp&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;đồng · không có trường cấm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ chiều nghịch bắt BUG-A1-02&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="600" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ir" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;IR — BIỂU DIỄN TRUNG GIAN  (JSON)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Test case ở mức Ý ĐỊNH — chưa phải mã chạy được&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;id · title · technique · param · partition · source (AI / HUMAN)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audit{label, reason} · expected_by_spec · request · expect.assert[]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="790" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Vì sao IR, không sinh thẳng JavaScript&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Có lược đồ → G6a kiểm tra được bằng máy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Assertion là descriptor → không thể sai&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;   cú pháp&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Sửa khuôn 1 lần → áp cho cả 144 test case&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Người đọc hiểu ngay test kiểm gì&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="790" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Điều kiện CHẶN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• thiếu expected_by_spec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• thiếu nhãn audit / lý do audit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• trùng ID test case&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• thiếu phân vùng bắt buộc theo danh mục&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• assertion async thiếu try/catch + done(e)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="g6a" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;G6a — KIỂM TRA IR   [tất định]   [ CỔNG CHẶN ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Không đạt  →  KHÔNG được đi tiếp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="950" width="520" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="g6b" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;G6b — AUDIT CỦA CON NGƯỜI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;THỦ CÔNG · BẮT BUỘC · không tự động hoá được&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gắn nhãn VALID / INVALID / INCOMPLETE cho từng TC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ bổ sung test case mà máy không sinh được&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="1110" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Kết quả audit&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• 9 / 110 TC do AI phải hiệu chỉnh&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• + 34 TC do con người viết thêm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• 6 / 24 lỗi CHỈ tìm được nhờ 34 TC này&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;   A1-05 · A3-02 · A2-02 · A3-06 · A1-01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1110" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="g6c" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;G6c — BIÊN DỊCH  [tất định]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Một nguồn sự thật duy nhất  →  số liệu trong báo cáo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;không thể lệch với collection&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;dashed=0;" vertex="1" parent="1">
