{
  "api_id": "API-2",
  "tc_prefix": "B2",
  "pool": "B",
  "fr": "FR-08",
  "name": "Thanh toan (checkout) + ap ma giam gia + vong doi don hang",
  "base_url": "{{baseUrl}}",
  "endpoints": [
    {
      "key": "checkout",
      "method": "POST",
      "path": "/api/checkout",
      "auth_required": true,
      "success_status": 201,
      "preconditions": "Da login, co {{token_user}}, gio hang co 1 san pham",
      "headers": "Authorization: Bearer {{token_user}}",
      "valid_body": { "items": [{ "product_id": 1, "quantity": 2 }], "total_amount": 200000, "shipping_address": "123 Nguyen Van Cu, Q5, TP.HCM" },
      "params": [
        {
          "name": "total_amount",
          "in": "body",
          "type": "number",
          "required": true,
          "partitions": [
            { "id": "valid", "value": 200000, "valid": true, "desc": "tong tien khop voi gio hang", "expected_status": 201, "assertions": "body co orderId; total_amount trong DB = tong tinh tu server", "priority": "P0" },
            { "id": "tampered_low", "value": 1, "valid": false, "desc": "client gui tong tien 1 dong - server phai tu tinh lai", "expected_status": 400, "assertions": "don hang KHONG duoc tao voi gia 1; GET /api/orders/:id phai tra dung gia that", "bug": "B-01", "priority": "P0" },
            { "id": "negative", "value": -100000, "valid": false, "desc": "tong tien am", "expected_status": 400, "bug": "B-01", "priority": "P0" },
            { "id": "zero", "value": 0, "valid": false, "boundary": true, "desc": "BVA - tong tien bang 0", "expected_status": 400, "bug": "B-01" },
            { "id": "string", "value": "200000", "valid": false, "desc": "tong tien sai kieu (string)", "expected_status": 400 },
            { "id": "omit", "omit": true, "valid": false, "desc": "thieu total_amount", "expected_status": 400 },
            { "id": "null", "value": null, "valid": false, "desc": "total_amount null", "expected_status": 400 },
            { "id": "huge", "value": 999999999999999, "valid": false, "boundary": true, "desc": "BVA - tong tien vuot gioi han", "expected_status": 400 },
            { "id": "float", "value": 200000.999, "valid": false, "desc": "tong tien co phan thap phan la", "expected_status": 400 }
          ]
        },
        {
          "name": "items",
          "in": "body",
          "type": "array",
          "required": true,
          "partitions": [
            { "id": "empty_array", "value": [], "valid": false, "desc": "gio hang rong", "expected_status": 400, "assertions": "khong duoc tao don hang rong", "bug": "B-04", "priority": "P0" },
            { "id": "omit", "omit": true, "valid": false, "desc": "thieu items - server hien bo qua hoan toan", "expected_status": 400, "bug": "B-04", "priority": "P0" },
            { "id": "qty_zero", "value": [{ "product_id": 1, "quantity": 0 }], "valid": false, "boundary": true, "desc": "BVA - so luong 0", "expected_status": 400 },
            { "id": "qty_negative", "value": [{ "product_id": 1, "quantity": -5 }], "valid": false, "desc": "so luong am (co the sinh tien am)", "expected_status": 400, "priority": "P0" },
            { "id": "qty_one", "value": [{ "product_id": 1, "quantity": 1 }], "valid": true, "boundary": true, "desc": "BVA - so luong 1 (bien duoi hop le)", "expected_status": 201 },
            { "id": "product_not_exist", "value": [{ "product_id": 999999, "quantity": 1 }], "valid": false, "desc": "san pham khong ton tai", "expected_status": 404 },
            { "id": "over_stock", "value": [{ "product_id": 1, "quantity": 100000 }], "valid": false, "desc": "vuot ton kho", "expected_status": 400 },
            { "id": "wrong_type", "value": "khong-phai-array", "valid": false, "desc": "items sai kieu", "expected_status": 400 }
          ]
        },
        {
          "name": "shipping_address",
          "in": "body",
          "type": "string",
          "required": true,
          "partitions": [
            { "id": "valid", "value": "123 Nguyen Van Cu, Q5, TP.HCM", "valid": true, "desc": "dia chi hop le", "expected_status": 201 },
            { "id": "empty", "value": "", "valid": false, "desc": "dia chi rong", "expected_status": 400, "bug": "B-12" },
            { "id": "null", "value": null, "valid": false, "desc": "dia chi null - hien van tao duoc don", "expected_status": 400, "bug": "B-12", "priority": "P0" },
            { "id": "omit", "omit": true, "valid": false, "desc": "thieu dia chi", "expected_status": 400, "bug": "B-12" },
            { "id": "xss", "value": "<script>alert('23127060')</script>", "valid": false, "desc": "payload XSS trong dia chi", "expected_status": 400, "sec": "SEC-06" },
            { "id": "too_long", "value": "A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A123456789A1", "valid": false, "boundary": true, "desc": "BVA - dia chi vuot 255 ky tu", "expected_status": 400 }
          ]
        }
      ]
    },
    {
      "key": "apply_coupon",
      "method": "POST",
      "path": "/api/apply-coupon",
      "auth_required": true,
      "success_status": 200,
      "preconditions": "Coupon PERC10 (10%, min 100000), FIX50K, EXPIRED, INACTIVE da seed",
      "headers": "Authorization: Bearer {{token_user}}",
      "valid_body": { "code": "PERC10", "total_amount": 200000, "user_id": "{{userId}}" },
      "params": [
        {
          "name": "code",
          "in": "body",
          "type": "string",
          "required": true,
          "partitions": [
            { "id": "valid_percent", "value": "PERC10", "valid": true, "desc": "Decision table T1 - ma % hop le, du dieu kien", "technique": "Decision Table", "expected_status": 200, "assertions": "discount_amount = 20000 (10% cua 200000)", "bug": "B-05", "priority": "P0" },
            { "id": "valid_fixed", "value": "FIX50K", "valid": true, "desc": "Decision table T2 - ma so tien co dinh", "technique": "Decision Table", "expected_status": 200, "assertions": "discount_amount = 50000" },
            { "id": "expired", "value": "EXPIRED", "valid": false, "desc": "Decision table T3 - ma het han", "technique": "Decision Table", "expected_status": 400, "bug": "B-08", "priority": "P0" },
            { "id": "inactive", "value": "INACTIVE", "valid": false, "desc": "Decision table T4 - ma bi vo hieu hoa", "technique": "Decision Table", "expected_status": 400 },
            { "id": "not_exist", "value": "KHONGCOMA23127060", "valid": false, "desc": "Decision table T5 - ma khong ton tai", "technique": "Decision Table", "expected_status": 404 },
            { "id": "empty", "value": "", "valid": false, "desc": "ma rong", "expected_status": 400 },
            { "id": "omit", "omit": true, "valid": false, "desc": "thieu code", "expected_status": 400 },
            { "id": "sqli", "value": "' OR '1'='1", "valid": false, "desc": "SQLi trong ma giam gia", "expected_status": 400, "sec": "SEC-01", "priority": "P0" },
            { "id": "case_lower", "value": "perc10", "valid": true, "desc": "ma viet thuong - hanh vi phai nhat quan voi spec", "expected_status": 200 }
          ]
        },
        {
          "name": "total_amount",
          "in": "body",
          "type": "number",
          "required": true,
          "partitions": [
            { "id": "below_min", "value": 99999, "valid": false, "boundary": true, "desc": "BVA - duoi min_order_amount 100000", "technique": "BVA", "expected_status": 400 },
            { "id": "equal_min", "value": 100000, "valid": true, "boundary": true, "desc": "BVA - BANG dung min_order_amount (loi bien > thay vi >=)", "technique": "BVA", "expected_status": 200, "assertions": "phai duoc ap ma vi dieu kien la >= min_order_amount", "bug": "B-06", "priority": "P0" },
            { "id": "above_min", "value": 100001, "valid": true, "boundary": true, "desc": "BVA - tren min_order_amount 1 dong", "technique": "BVA", "expected_status": 200 },
            { "id": "negative", "value": -200000, "valid": false, "desc": "tong tien am", "expected_status": 400 },
            { "id": "discount_exceeds", "value": 10000, "valid": false, "desc": "ma giam 50k nhung don chi 10k - khong duoc am tien", "expected_status": 400, "priority": "P0" }
          ]
        },
        {
          "name": "user_id",
          "in": "body",
          "type": "number",
          "required": true,
          "partitions": [
            { "id": "self", "value": "{{userId}}", "valid": true, "desc": "user_id cua chinh minh", "expected_status": 200 },
            { "id": "other_user", "value": 99999, "valid": false, "desc": "user_id cua nguoi khac - server phai lay tu JWT", "expected_status": 403, "sec": "SEC-04", "bug": "B-07", "priority": "P0" },
            { "id": "omit", "omit": true, "valid": false, "desc": "thieu user_id - bypass kiem tra han muc su dung", "expected_status": 401, "bug": "B-07", "priority": "P0" },
            { "id": "null", "value": null, "valid": false, "desc": "user_id null", "expected_status": 400, "bug": "B-07" }
          ]
        }
      ]
    }
  ],
  "state_machine": {
    "name": "Vong doi don hang (FR-10)",
    "endpoint": "/api/admin/orders/{{orderId}}/status",
    "method": "PUT",
    "states": ["pending", "confirmed", "shipping", "delivered", "canceled"],
    "transitions": [
      { "from": "pending", "to": "confirmed", "allowed": true, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 200 },
      { "from": "confirmed", "to": "shipping", "allowed": true, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 200 },
      { "from": "shipping", "to": "delivered", "allowed": true, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 200 },
      { "from": "pending", "to": "canceled", "allowed": true, "endpoint": "/api/orders/{{orderId}}/cancel", "body": {}, "headers": "Authorization: Bearer {{token_user}}", "expected_status": 200 },
      { "from": "confirmed", "to": "canceled", "allowed": true, "endpoint": "/api/orders/{{orderId}}/cancel", "body": {}, "headers": "Authorization: Bearer {{token_user}}", "expected_status": 200 },
      { "from": "pending", "to": "shipping", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400, "preconditions": "Nhay coc trang thai" },
      { "from": "pending", "to": "delivered", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "confirmed", "to": "pending", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400, "preconditions": "Lui trang thai" },
      { "from": "confirmed", "to": "delivered", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "shipping", "to": "pending", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "shipping", "to": "confirmed", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "shipping", "to": "canceled", "allowed": false, "endpoint": "/api/orders/{{orderId}}/cancel", "body": {}, "headers": "Authorization: Bearer {{token_user}}", "expected_status": 400, "assertions": "don dang giao KHONG duoc tu huy boi khach hang", "bug": "B-09", "priority": "P0" },
      { "from": "delivered", "to": "shipping", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "delivered", "to": "canceled", "allowed": false, "endpoint": "/api/orders/{{orderId}}/cancel", "body": {}, "headers": "Authorization: Bearer {{token_user}}", "expected_status": 400 },
      { "from": "delivered", "to": "delivered", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400, "preconditions": "Trang thai cuoi - khong doi duoc nua" },
      { "from": "canceled", "to": "delivered", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400, "assertions": "don da huy TUYET DOI khong duoc chuyen sang da giao", "bug": "B-10", "priority": "P0" },
      { "from": "canceled", "to": "confirmed", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "expected_status": 400 },
      { "from": "canceled", "to": "canceled", "allowed": false, "endpoint": "/api/orders/{{orderId}}/cancel", "body": {}, "headers": "Authorization: Bearer {{token_user}}", "expected_status": 400, "preconditions": "Huy 2 lan" },
      { "from": "pending", "to": "invalid_value", "allowed": false, "headers": "Authorization: Bearer {{token_admin}}", "body": { "status": "khong_ton_tai_23127060" }, "expected_status": 400, "preconditions": "Gia tri trang thai khong nam trong enum" },
      { "from": "pending", "to": "confirmed_by_user", "allowed": false, "headers": "Authorization: Bearer {{token_user}}", "body": { "status": "confirmed" }, "expected_status": 403, "assertions": "user thuong KHONG duoc doi trang thai don hang", "sec": "SEC-05", "bug": "B-03", "priority": "P0" }
    ]
  },
  "security": [
    { "sec": "SEC-01", "technique": "SQL Injection", "title": "SQLi qua ma giam gia", "method": "POST", "endpoint": "/api/apply-coupon", "body": { "code": "' UNION SELECT 1,1,1,1,1,1--", "total_amount": 200000, "user_id": "{{userId}}" }, "expected_status": 400, "priority": "P0" },
    { "sec": "SEC-02", "technique": "Information Disclosure", "title": "Response checkout khong duoc lo thong tin noi bo", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5" }, "expected_status": 201, "assertions": "body khong chua stack trace, ten bang, duong dan file" },
    { "sec": "SEC-03", "technique": "Missing Authentication", "title": "Checkout khong kem token phai bi tu choi", "method": "POST", "endpoint": "/api/checkout", "headers": "-", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5" }, "expected_status": 401, "priority": "P0" },
    { "sec": "SEC-03", "technique": "Missing Authentication", "title": "Apply-coupon khong kem token phai bi tu choi", "method": "POST", "endpoint": "/api/apply-coupon", "headers": "-", "body": { "code": "PERC10", "total_amount": 200000, "user_id": 1 }, "expected_status": 401, "bug": "B-07", "priority": "P0" },
    { "sec": "SEC-03", "technique": "Broken JWT", "title": "Token JWT bi sua chu ky phai bi tu choi", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJpZCI6MSwicm9sZSI6ImFkbWluIn0.invalid23127060", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5" }, "expected_status": 403, "priority": "P0" },
    { "sec": "SEC-04", "technique": "IDOR", "title": "Xem don hang cua nguoi khac qua GET /api/orders/:id", "method": "GET", "endpoint": "/api/orders/{{victimOrderId}}", "headers": "Authorization: Bearer {{token_attacker}}", "expected_status": 403, "assertions": "khong tra ve dia chi, tong tien cua don hang nguoi khac", "bug": "B-02", "priority": "P0" },
    { "sec": "SEC-04", "technique": "IDOR", "title": "Xem don hang khong kem token", "method": "GET", "endpoint": "/api/orders/{{victimOrderId}}", "headers": "-", "expected_status": 401, "bug": "B-02", "priority": "P0" },
    { "sec": "SEC-04", "technique": "IDOR", "title": "Huy don hang cua nguoi khac", "method": "PUT", "endpoint": "/api/orders/{{victimOrderId}}/cancel", "headers": "Authorization: Bearer {{token_attacker}}", "body": {}, "expected_status": 403, "priority": "P0" },
    { "sec": "SEC-05", "technique": "Privilege Escalation", "title": "User thuong goi endpoint admin doi trang thai don", "method": "PUT", "endpoint": "/api/admin/orders/{{orderId}}/status", "headers": "Authorization: Bearer {{token_user}}", "body": { "status": "delivered" }, "expected_status": 403, "bug": "B-03", "priority": "P0" },
    { "sec": "SEC-05", "technique": "Privilege Escalation", "title": "User thuong xem toan bo don hang qua GET /api/admin/orders", "method": "GET", "endpoint": "/api/admin/orders", "headers": "Authorization: Bearer {{token_user}}", "expected_status": 403, "priority": "P0" },
    { "sec": "SEC-06", "technique": "Input Validation / XSS", "title": "XSS trong shipping_address phai bi chan hoac escape", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "<img src=x onerror=alert('23127060')>" }, "expected_status": 400 },
    { "sec": "SEC-06", "technique": "Mass Assignment", "title": "Gui kem status='delivered' khi checkout", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5", "status": "delivered" }, "expected_status": 201, "assertions": "don hang moi tao phai o trang thai 'pending', KHONG phai 'delivered'", "priority": "P0" },
    { "sec": "SEC-07", "technique": "Abuse / Race Condition", "title": "Ap cung 1 coupon 10 lan lien tiep phai bi chan boi usage limit", "method": "POST", "endpoint": "/api/apply-coupon", "headers": "Authorization: Bearer {{token_user}}", "preconditions": "Chay Collection Runner 10 iteration", "body": { "code": "PERC10", "total_amount": 200000, "user_id": "{{userId}}" }, "expected_status": 400, "assertions": "tu lan thu N+1 phai bi tu choi theo usage_limit", "bug": "B-11", "priority": "P0" },
    { "sec": "SEC-07", "technique": "Abuse", "title": "Spam checkout 20 lan lien tiep phai bi rate-limit", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5" }, "expected_status": 429 }
  ],
  "schema_cases": [
    { "title": "Response 201 cua checkout khop schema { orderId: integer, message: string }", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [{ "product_id": 1, "quantity": 1 }], "total_amount": 100000, "shipping_address": "Q5" }, "expected_status": 201, "schema_ref": "checkout_success" },
    { "title": "Response loi cua checkout khop schema { error: string }", "method": "POST", "endpoint": "/api/checkout", "headers": "Authorization: Bearer {{token_user}}", "body": { "items": [], "total_amount": -1, "shipping_address": null }, "expected_status": 400, "schema_ref": "error_schema" },
    { "title": "Response cua apply-coupon khop schema { discount_amount: number, final_amount: number }", "method": "POST", "endpoint": "/api/apply-coupon", "headers": "Authorization: Bearer {{token_user}}", "body": { "code": "PERC10", "total_amount": 200000, "user_id": "{{userId}}" }, "expected_status": 200, "schema_ref": "coupon_success", "assertions": "discount_amount la number va > 0 va < total_amount", "bug": "B-05" },
    { "title": "Response cua GET /api/orders/:id khop schema don hang day du", "method": "GET", "endpoint": "/api/orders/{{orderId}}", "headers": "Authorization: Bearer {{token_user}}", "expected_status": 200, "schema_ref": "order_schema", "assertions": "co id, user_id, total_amount (number), status (enum 5 gia tri), shipping_address" },
    { "title": "Truong status luon thuoc enum 5 gia tri hop le", "method": "GET", "endpoint": "/api/orders/my-orders", "headers": "Authorization: Bearer {{token_user}}", "expected_status": 200, "schema_ref": "orders_array", "assertions": "moi phan tu co status thuoc [pending,confirmed,shipping,delivered,canceled]" },
    { "title": "total_amount luon la number, khong bao gio la string", "method": "GET", "endpoint": "/api/orders/my-orders", "headers": "Authorization: Bearer {{token_user}}", "expected_status": 200, "schema_ref": "orders_array", "assertions": "typeof total_amount === 'number' cho moi phan tu" }
  ]
}
