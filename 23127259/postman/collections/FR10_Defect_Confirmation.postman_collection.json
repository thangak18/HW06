    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mandatory X-Student-Id header injection across all confirmation requests",
          "const studentId = pm.environment.get('studentId') || '23127259';",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: studentId });"
        ]
      }
    }
  ],
