        {
          "name": "[AUTH-01] Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin Login Success', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    var data = pm.response.json();",
                  "    var token = data.token || (data.data && data.data.token);",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('adminToken', token);",
                  "});"
                ]
              }
            }
          ]
        },
